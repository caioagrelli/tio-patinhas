# Copie para .env. Use uma senha própria (hexadecimal evita escape na URL).
POSTGRES_DB=patinhas
POSTGRES_USER=patinhas
POSTGRES_PASSWORD=troque-por-uma-senha-local
POSTGRES_PORT=5432
APP_PORT=8080
# Para desenvolvimento fora do Docker:
DATABASE_URL=postgresql://patinhas:troque-por-uma-senha-local@127.0.0.1:5432/patinhas?schema=public
PORT=3000
# true quando o acesso ao site ocorrer por HTTPS em produção
COOKIE_SECURE=false
# Cloudflare Turnstile no login e no cadastro (deixe vazio para desligar).
# Chaves em dash.cloudflare.com > Turnstile. Para testar localmente, as chaves de teste
# da Cloudflare sempre aprovam: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Login com Google, opcional (usuário e senha continuam funcionando; vazio esconde o botão). Crie um "ID do cliente OAuth" do tipo
# "Aplicativo da Web" em console.cloud.google.com > APIs e serviços > Credenciais.
# URI de redirecionamento autorizado: APP_URL + /api/auth/google/callback
# APP_URL é o endereço público do site: http://localhost:5173 em desenvolvimento.
APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pagamentos com Mercado Pago (Orders API + Assinaturas). Sem o Access Token, o checkout fica desativado.
# Credenciais em mercadopago.com.br/developers > Suas integrações > (aplicação) > Credenciais.
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Segredo do webhook (evento "Order" e assinaturas), mostrado ao salvar a URL
# https://SEU-DOMINIO/api/billing/webhook em Suas integrações > Webhooks.
MERCADOPAGO_WEBHOOK_SECRET=
# E-mails (boas-vindas, confirmação de e-mail, "esqueci minha senha" e aviso de senha trocada).
# Qualquer serviço SMTP. Vazio: em desenvolvimento o e-mail (com o link) aparece no terminal do servidor.
# Gmail (sem domínio próprio; até ~500 por dia): crie uma senha de app em myaccount.google.com/apppasswords
#   SMTP_URL=smtps://sua.conta%40gmail.com:SENHA-DE-APP-SEM-ESPACOS@smtp.gmail.com:465
# Amazon SES ou Resend (com domínio próprio, recomendado em produção):
#   SMTP_URL=smtps://USUARIO:SENHA@email-smtp.us-east-2.amazonaws.com:465   ou   smtps://resend:re_xxx@smtp.resend.com:465
SMTP_URL=
EMAIL_FROM="CRAB FINANCE <nao-responda@seu-dominio.com.br>"
# Crab AI (assistente financeiro com Claude). Sem a chave, o Crab AI aparece como "não configurado".
# Crie a chave em platform.claude.com > API Keys. CRAB_AI_MODEL é opcional (padrão: claude-haiku-5-5).
# CRAB_AI_MONTHLY_TOKENS é a franquia mensal por usuário (padrão: 1000000); admins não têm limite.
ANTHROPIC_API_KEY=
CRAB_AI_MODEL=
CRAB_AI_MONTHLY_TOKENS=
# Quantos proxies HTTPS ficam na frente do app: 1 = Caddy; 2 = Cloudflare com proxy (nuvem laranja) + Caddy.
# Vazio ou 0 sem proxy. Necessário para o limite de tentativas de login contar o IP de cada visitante.
TRUST_PROXY=
# Redis compartilha os limites de tentativas entre vários servidores do app (o compose.prod.yaml já preenche).
REDIS_URL=

# ===== Produção (compose.prod.yaml); veja DEPLOY.md =====
# Domínio do site; o certificado HTTPS é emitido e renovado sozinho pelo Caddy.
# Sem domínio ainda, use <ip-com-hifens>.sslip.io (ex.: 3-140-72-220.sslip.io) para testar com HTTPS.
DOMAIN=
# Quantos servidores do app o deploy automático sobe, e quantas conexões ao banco cada um pode abrir
# (servidores x conexões precisa caber no limite do banco; o PostgreSQL padrão aceita 100).
APP_REPLICAS=2
DATABASE_CONNECTION_LIMIT=10
# Backup diário criptografado. Guarde a BACKUP_PASSPHRASE também fora do servidor: sem ela o backup não abre.
# Gere com: openssl rand -hex 32
BACKUP_PASSPHRASE=
# Horário em UTC (06:00 UTC = 03:00 em Brasília) e dias de retenção no armazenamento externo.
BACKUP_TIME=06:00
BACKUP_KEEP_DAYS=30
# Armazenamento externo S3 compatível. Ex.: Cloudflare R2 -> BACKUP_REMOTE=offsite:nome-do-bucket/crab-finance,
# BACKUP_S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com. Backblaze B2: BACKUP_S3_PROVIDER=Other.
BACKUP_REMOTE=
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Opcional: URL do healthchecks.io que avisa se um dia passar sem backup bem-sucedido.
BACKUP_HEALTHCHECK_URL=
