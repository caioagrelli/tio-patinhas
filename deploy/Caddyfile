# HTTPS automático (Let's Encrypt, renovado pelo próprio Caddy) e balanceamento entre os servidores do app.
{
	servers {
		# Só a Cloudflare pode informar o IP do visitante (lista de cloudflare.com/ips, conferida em 02/11/2026).
		# Quem acessa o servidor direto não consegue falsificar o X-Forwarded-For.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy {
		# Descobre todos os containers "app" (docker compose up --scale app=N) e reparte as requisições.
		dynamic a {
			name app
			port 3000
			refresh 5s
		}
		lb_policy least_conn
		lb_try_duration 10s
		health_uri /api/health
		health_interval 10s
		# Respostas do Crab AI chegam aos poucos (streaming): repassa na hora, sem acumular.
		flush_interval -1
	}

	log {
		output stdout
		format json
	}
}
