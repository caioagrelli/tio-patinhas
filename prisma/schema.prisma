generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  username String @unique
  name String
  // Legacy password accounts keep their hash; Google sign-in is the only login method.
  passwordHash String?
  googleId String? @unique
  email String?
  // Paid plan: "mensal", "anual" or "vitalicio". planExpiresAt is null for lifetime access.
  plan String?
  planExpiresAt DateTime?
  payments Payment[]
  aiUsage AiUsage[]
  aiConversations AiConversation[]
  active Boolean @default(true)
  isAdmin Boolean @default(false)
  balance BigInt @default(0)
  createdAt DateTime @default(now())
  sessions Session[]
  categories Category[]
  paymentMethods PaymentMethod[]
  cards Card[]
  incomeTypes IncomeType[]
  transactions Transaction[]
  boxes SavingsBox[]
  recurrences Recurrence[]
  plans InstallmentPlan[]
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model Category {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  color String @default("#d4ff3f")
  icon String @default("💰")
  isDefault Boolean @default(false)
  transactions Transaction[]
  recurrences Recurrence[]
  plans InstallmentPlan[]
  @@index([userId])
}
model PaymentMethod {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  icon String @default("💳")
  kind String
  transactions Transaction[]
  recurrences Recurrence[]
  plans InstallmentPlan[]
  @@index([userId])
}
model Card {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  color String @default("#d4ff3f")
  limit BigInt?
  closingDay Int?
  dueDay Int?
  transactions Transaction[]
  recurrences Recurrence[]
  plans InstallmentPlan[]
  @@index([userId])
}
model IncomeType {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  icon String @default("💵")
  color String @default("#d4ff3f")
  transactions Transaction[]
  recurrences Recurrence[]
  @@index([userId])
}
model Transaction {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  kind String @default("avista")
  value BigInt
  description String @default("")
  date String
  applied Boolean @default(false)
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethodId String?
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  cardId String?
  card Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  incomeTypeId String?
  incomeType IncomeType? @relation(fields: [incomeTypeId], references: [id], onDelete: SetNull)
  recurrenceId String?
  recurrence Recurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  planId String?
  plan InstallmentPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  installmentNumber Int?
  createdAt DateTime @default(now())
  @@index([userId, date])
  @@unique([recurrenceId, date])
}
model SavingsBox {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  amount BigInt @default(0)
  goal BigInt?
  icon String @default("🐷")
  color String @default("#d4ff3f")
  goalAlertDismissed Boolean @default(false)
  movements SavingsMovement[]
  createdAt DateTime @default(now())
  @@index([userId])
}
model SavingsMovement {
  id String @id @default(uuid())
  boxId String
  box SavingsBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  type String
  value BigInt
  createdAt DateTime @default(now())
}
model Recurrence {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  value BigInt
  description String @default("")
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  incomeTypeId String?
  incomeType IncomeType? @relation(fields: [incomeTypeId], references: [id], onDelete: SetNull)
  paymentMethodId String?
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  cardId String?
  card Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  dayOfMonth Int
  startDate String
  endDate String?
  active Boolean @default(true)
  lastGenerated String?
  transactions Transaction[]
  @@index([userId])
}
model InstallmentPlan {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String @default("")
  totalValue BigInt
  installments Int
  firstDate String
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethodId String?
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  cardId String?
  card Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  @@index([userId])
}

/// A checkout started with Mercado Pago: an order (annual, lifetime) or a subscription (monthly).
model Payment {
  id String @id @default(uuid())
  /// Kept (without the person) when the account is deleted: sales and AI costs stay in the books.
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan String
  kind String
  reference String @unique
  providerId String? @unique
  amount BigInt
  status String @default("created")
  appliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Tokens and cost of one Crab AI question (all model calls of that question added up).
model AiUsage {
  id String @id @default(uuid())
  /// Kept (without the person) when the account is deleted: sales and AI costs stay in the books.
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  model String
  rounds Int
  inputTokens Int
  outputTokens Int
  cacheReadTokens Int
  cacheWriteTokens Int
  /// Cost in millionths of a US dollar, from the model's price list.
  costMicroUsd Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// A Crab AI chat, listed in the sidebar like a regular assistant.
model AiConversation {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  pinned Boolean @default(false)
  messages AiMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model AiMessage {
  id String @id @default(uuid())
  conversationId String
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role String
  content String
  /// Saved answers are listed under "Artefatos".
  saved Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}
